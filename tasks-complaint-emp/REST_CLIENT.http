# Employee Complaint API - RESTful Client Tests
# Copy this file to IntelliJ and run as HTTP Client, or import to Postman
# Base URL: http://localhost:9999/tasks-complaint-emp

### ======================================================
### CRUD OPERATIONS
### ======================================================

### 1. Create Employee Complaint
POST http://localhost:9999/tasks-complaint-emp/api/emp-complaints
Content-Type: application/json

{
  "appName": "SAP",
  "complaintName": "Login timeout error",
  "placeName": "Main Office",
  "department": "IT",
  "subPlace": "Server Room",
  "empName": "Ahmed Ali",
  "empNumber": 10234,
  "empMobile": 551234567,
  "isEnable": true
}

### 2. Create Another Employee Complaint
POST http://localhost:9999/tasks-complaint-emp/api/emp-complaints
Content-Type: application/json

{
  "appName": "Oracle",
  "complaintName": "Database connection failure",
  "placeName": "Branch Office",
  "department": "Finance",
  "subPlace": "Data Center",
  "empName": "Mohamed Hassan",
  "empNumber": 10567,
  "empMobile": 559876543,
  "isEnable": true
}

### 3. Create Third Employee Complaint
POST http://localhost:9999/tasks-complaint-emp/api/emp-complaints
Content-Type: application/json

{
  "appName": "SAP",
  "complaintName": "Report generation slow",
  "placeName": "Main Office",
  "department": "HR",
  "subPlace": "none",
  "empName": "Sara Ibrahim",
  "empNumber": 10890,
  "empMobile": 557654321,
  "isEnable": false
}

### 4. Get All Employee Complaints
GET http://localhost:9999/tasks-complaint-emp/api/emp-complaints

### 5. Get Employee Complaint by ID
GET http://localhost:9999/tasks-complaint-emp/api/emp-complaints/1

### 6. Update Employee Complaint
PUT http://localhost:9999/tasks-complaint-emp/api/emp-complaints/1
Content-Type: application/json

{
  "appName": "SAP",
  "complaintName": "Login timeout resolved",
  "placeName": "Main Office",
  "department": "IT",
  "subPlace": "Server Room",
  "empName": "Ahmed Ali",
  "empNumber": 10234,
  "empMobile": 551234567,
  "isEnable": false
}

### 7. Delete Employee Complaint
DELETE http://localhost:9999/tasks-complaint-emp/api/emp-complaints/3

